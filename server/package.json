{
  "name": "cleanmac-license-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/license-local-server.ts",
    "build": "tsc --project tsconfig.node.json",
    "start": "node dist/license-local-server.js",
    "dev:worker": "wrangler dev",
    "deploy:worker": "wrangler deploy",
    "test:email": "node scripts/send-test-license-email.mjs",
    "typecheck": "npm run typecheck:worker && npm run typecheck:wechatpay",
    "typecheck:worker": "tsc --noEmit",
    "typecheck:wechatpay": "tsc --project tsconfig.node.json --noEmit",
    "dev:license": "tsx src/license-local-server.ts",
    "start:license": "node dist/license-local-server.js",
    "dev:wechatpay": "tsx src/wechatpay-local-server.ts",
    "start:wechatpay": "node dist/wechatpay-local-server.js",
    "build:wechatpay": "tsc --project tsconfig.node.json"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.120.0"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
