# Local-only Hugo override for Taobao purchase testing.
# Copy this file to site/config.local.toml, then point purchaseURL at your Taobao item or shop URL.
# Run with: cd site && hugo server --config config.toml,config.local.toml

[params]
  purchaseURL = 'https://shop.taobao.com/'
  purchasePriceText = '¥2.00'
  paymentProvider = 'taobao'
  paymentAutoOpenParam = 'checkout'
  paymentAutoOpenValue = 'cleanmac'
