# Copy to .paddle.sandbox.env and fill values from https://sandbox-vendors.paddle.com/
# Required for automatic sandbox catalog setup:
PADDLE_API_KEY=pdl_sdbx_replace_me
PADDLE_ENV=sandbox

# Optional: if you already created these in Paddle sandbox, the setup script can just write site/config.local.toml.
# PADDLE_SANDBOX_PRICE_ID=pri_...
# PADDLE_SANDBOX_CLIENT_TOKEN=test_...
